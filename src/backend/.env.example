# VanRides Backend (.env)
#
# Copie este arquivo para `.env` e preencha os valores.
# - NÃO versione `.env` (este repo ignora por padrão).
# - Em produção (VPS/Swarm), prefira configurar variáveis diretamente no service/stack.

# Perfil do Spring
# Guardrails de startup:
# - local/test aceitam defaults de desenvolvimento.
# - dev/prod exigem VANRIDES_JWT_SECRET forte.
# - prod/prod-like exigem VANRIDES_AUTH_BASIC_ENABLED=false e email provider real.
SPRING_PROFILES_ACTIVE=local

# HTTP
SERVER_PORT=8080
VANRIDES_HTTP_MAX_THREADS=200

# Fuso IANA usado para definir o dia operacional de viagens/localizacao.
VANRIDES_OPERATIONS_TIME_ZONE=America/Sao_Paulo

# Banco de dados (PostgreSQL)
# Banco isolado local; nunca reutilize o banco de outra pessoa.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/vanrides_db
SPRING_DATASOURCE_USERNAME=vanrides_user
SPRING_DATASOURCE_PASSWORD=change-me

# JPA/Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# Google (usado no GeocodingService)
GOOGLE_API_KEY=

# Push externo (nenhum provider real e empacotado nesta versao).
VANRIDES_PUSH_PROVIDER=none

# CORS (lista separada por vírgula; pode usar "*" / padrões)
VANRIDES_CORS_ALLOWED_ORIGIN_PATTERNS=*
VANRIDES_CORS_ALLOWED_METHODS=*
VANRIDES_CORS_ALLOWED_HEADERS=*

# Auth v2 (JWT + refresh)
# Default local mantem compatibilidade com clientes legados; em PROD use false.
VANRIDES_AUTH_BASIC_ENABLED=true
# Em desenvolvimento, se VANRIDES_JWT_SECRET ficar vazio o backend gera chave efêmera
# (válida só até reiniciar a aplicação). Para estabilidade, defina um valor forte.
VANRIDES_JWT_SECRET=
VANRIDES_ACCESS_TOKEN_TTL_MINUTES=15
VANRIDES_REFRESH_TOKEN_TTL_DAYS=30

# Proteção de abuso. Ambientes publicados não iniciam com rate limit desligado.
VANRIDES_RATE_LIMIT_ENABLED=true
VANRIDES_RATE_LIMIT_SENSITIVE_LIMIT=30
VANRIDES_RATE_LIMIT_WINDOW_SECONDS=60
VANRIDES_RATE_LIMIT_MAX_ENTRIES_PER_ROUTE=10000
# Default fail-closed: vazio ignora X-Forwarded-For. Nunca use a subnet overlay
# inteira; configure somente peers de ingress comprovados antes da promoção.
VANRIDES_RATE_LIMIT_TRUSTED_PROXY_CIDRS=
VANRIDES_RATE_LIMIT_FORWARDED_MAX_BYTES=1024
VANRIDES_RATE_LIMIT_FORWARDED_MAX_HOPS=10
VANRIDES_REQUEST_BODY_MAX_BYTES=1048576
VANRIDES_REQUEST_BODY_MAX_CONCURRENT_READS=32
# Deve sobrar pelo menos esta quantidade fora do bulkhead de leitura de body.
VANRIDES_REQUEST_BODY_RESERVED_REQUEST_THREADS=16

# Email transacional / verificacao de e-mail
# Use provider=log em dev local ou provider=resend quando tiver o subdominio
# um dominio proprio verificado no provider. O
# provider log registra apenas evento agregado, nunca destinatario, corpos ou
# token.
VANRIDES_EMAIL_PROVIDER=log
VANRIDES_EMAIL_FROM=VanRides <noreply@example.invalid>
VANRIDES_EMAIL_RESEND_API_KEY=
VANRIDES_EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
VANRIDES_EMAIL_VERIFICATION_RESEND_COOLDOWN_MINUTES=15
# Local pode usar HTTP loopback. Em perfis publicados, use HTTPS publico sem
# credenciais, query, fragmento, placeholder ou trailing slash e preserve o
# path exato /auth/email-verifications/confirm. O backend acrescenta
# #token=<urlencoded>; nunca inclua o token nesta base.
VANRIDES_EMAIL_VERIFICATION_PUBLIC_BASE_URL=http://localhost:8080/auth/email-verifications/confirm

# DEV/QA apenas. Em prod/prod-like deve ficar vazio/ausente.
VANRIDES_QA_AUTO_VERIFY_EMAIL_DOMAINS=
